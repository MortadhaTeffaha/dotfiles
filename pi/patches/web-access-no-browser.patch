# Patch: pi-web-access — force workflow "none" when config says "none"
#
# Problem: The web_search tool description says "summary-review" is the default,
# so the model passes workflow: "summary-review" explicitly, overriding the
# config's workflow: "none". This opens a Chrome window for curation.
#
# Fix: When config workflow is "none", ignore the model's workflow parameter.
# Also update the tool description to say "none" is the recommended default.
#
# Apply after `pi update` or `pi update pi-web-access`:
#   patch -p1 ~/.pi/agent/npm/node_modules/pi-web-access/index.ts < this-file
#
# Or re-apply manually by editing index.ts:
#   1. Line ~1783: Change `params.workflow ?? configWorkflow` to
#      `configWorkflow === "none" ? "none" : (params.workflow ?? configWorkflow)`
#   2. Line ~1753: Update tool description to say "none" is default
#   3. Line ~1768: Update workflow param description to say "none" is recommended

--- a/index.ts
+++ b/index.ts
@@ -1780,7 +1780,7 @@
 				const queryList = normalizeQueryList(rawQueryList);
 				const configWorkflow = loadConfigForExtensionInit().workflow;
-				const workflow = resolveWorkflow(params.workflow ?? configWorkflow, ctx?.hasUI !== false);
+				const workflow = resolveWorkflow(configWorkflow === "none" ? "none" : (params.workflow ?? configWorkflow), ctx?.hasUI !== false);
 				const shouldCurate = workflow === "summary-review";
