{
  "defaultProvider": "ai-gw-baseten",
  "defaultModel": "baseten/zai-org/GLM-5.2",
  "defaultThinkingLevel": "high",
  "packages": [
    "npm:context-mode",
    "npm:pi-web-access",
    "npm:pi-mcp-adapter",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-markdown-preview",
    "npm:pi-powerline-footer@0.15.1",
    "../../dd/datadog-pi-packages/packages/refresh-models",
    "npm:pi-herdr-subagents",
    "npm:@plannotator/pi-extension",
    "npm:pi-session-auto-rename"
  ],
  "theme": "dark",
  "powerline": {
    "layout": {
      "left": [
        "model",
        "thinking",
        "shell_mode",
        "path",
        "git",
        "queue",
        "session",
        "context_pct",
        "cache_read",
        "cost"
