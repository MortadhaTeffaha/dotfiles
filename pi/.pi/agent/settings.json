{
  "defaultProvider": "ai-gw-databricks",
  "defaultModel": "databricks/glm-5-3-pt",
  "defaultThinkingLevel": "high",
  "packages": [
    "npm:context-mode",
    "npm:pi-mcp-adapter",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-markdown-preview",
    "npm:pi-powerline-footer@0.15.1",
    "../../dd/datadog-pi-packages/packages/refresh-models",
    "npm:pi-herdr-subagents",
    "npm:@plannotator/pi-extension",
    "npm:pi-session-auto-rename",
    "npm:@zeldrisho/pi-web-fetch"
  ],
  "theme": "dracula",
  "powerline": {
    "layout": {
      "left": [
        "model",
        "thinking",
        "shell_mode",
        "path",
        "git",
        "queue",
        "session",
        "context_pct",
        "cache_read",
        "cost"
      ],
      "right": [],
      "secondary": []
    },
    "segmentOptions": {
      "model": {
        "showThinkingLevel": false
      },
      "path": {
        "mode": "basename"
      }
    }
  },
  "defaultProjectTrust": "always",
  "lastChangelogVersion": "0.84.4"
}
